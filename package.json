{
  "name": "apni-committee",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "claim-legacy": "node --env-file-if-exists=.env.local scripts/claim-legacy.mjs",
    "test:browser": "node tests/browser-flow.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-db.mjs",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-db.mjs",
    "db:import-local": "node --env-file-if-exists=.env.local scripts/import-local.mjs",
    "deploy:check": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@neondatabase/serverless": "1.2.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "puppeteer-core": "^25.17.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
